# Copy this file to ".env" (same folder as docker-compose.yml) and fill in your own values.
# Do NOT commit the real .env file.

SERVER_NAME=My Valheim Server
WORLD_NAME=MyWorld
# At least 5 characters, and must not match the server or world name
SERVER_PASS=change-me-please
# Your timezone, e.g. America/Denver, Europe/London
TZ=America/Denver
